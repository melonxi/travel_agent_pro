# Copy this file to .env in the repository root. Never commit the real .env.

# Choose one live LLM provider.
DEFAULT_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
# OPENAI_BASE_URL=

# Anthropic alternative:
# DEFAULT_PROVIDER=anthropic
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-4-20250514
# ANTHROPIC_BASE_URL=

# Optional travel-data tools. Missing keys disable or degrade the related tools.
GOOGLE_MAPS_API_KEY=
OPENWEATHER_API_KEY=
TAVILY_API_KEY=
AMADEUS_API_KEY=
AMADEUS_API_SECRET=
FLYAI_API_KEY=

# Optional Xiaohongshu CLI overrides.
# XHS_CLI_BIN=xhs
# XHS_CLI_TIMEOUT=30

# Set to true when Jaeger / an OTLP collector is not running.
# OTEL_SDK_DISABLED=true
